    "@qdrant/js-client-rest": "^1.18.0",
    "@teachmeany/shared": "file:../../packages/shared",
    "bullmq": "^5.58.0",
    "fastify": "^5.3.3",
    "ioredis": "^5.6.1",
    "postgres": "^3.4.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
