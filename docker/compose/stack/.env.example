# Public host the browser uses to reach noVNC (your machine when using published ports)
VNC_PUBLIC_HOST=localhost
VNC_PUBLIC_PORT=6080

# Ollama for embeddings (host install or `docker compose --profile ollama up`)
OLLAMA_URL=http://host.docker.internal:11434

# Frontend (browser → host-mapped backend)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
